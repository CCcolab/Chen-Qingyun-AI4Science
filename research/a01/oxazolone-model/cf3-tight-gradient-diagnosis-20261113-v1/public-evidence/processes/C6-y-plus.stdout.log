                'orbital_gradient_backend_norm': float(env['norm_gorb']), 'density_change_norm': float(env['norm_ddm']),
                'delta_energy_Eh': float(env['e_tot'] - env['last_hf_e']), 'energy_Eh': float(env['e_tot']),
