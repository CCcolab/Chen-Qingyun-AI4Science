        atoms = np.linalg.norm(gradient, axis=1)
        state.update(gradient_complete=True, gradient_Eh_per_bohr=gradient.tolist(),
            gradient_npy_sha256=sha(output / 'gradient.npy'), checkpoint_sha256=sha(output / 'scf.chk'),
            gradient_atom_norm_rms_Eh_bohr=float(np.sqrt(np.mean(atoms * atoms))),
            gradient_atom_norm_max_Eh_bohr=float(atoms.max()),
            gradient_cartesian_component_rms_Eh_bohr=float(np.sqrt(np.mean(gradient * gradient))),
            gradient_cartesian_component_max_Eh_bohr=float(np.max(np.abs(gradient))),
            net_gradient_Eh_bohr=gradient.sum(axis=0).tolist())
        if spec['point_id'] == 'center':
            state['center_gradient_check_passed'] = (state['gradient_atom_norm_rms_Eh_bohr'] <= 3e-4
