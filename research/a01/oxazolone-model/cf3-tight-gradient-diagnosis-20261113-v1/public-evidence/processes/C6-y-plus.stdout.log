            gradient_response={'grid_response': True, 'auxbasis_response': True,
                'equilibrium_solvation': bool(mf.with_solvent.equilibrium_solvation),
                'frozen': bool(mf.with_solvent.frozen), 'class_name': type(grad).__name__})
        save(); began = time.monotonic()
        gradient = np.asarray(grad.kernel(), dtype=float)
        state['gradient_seconds'] = time.monotonic() - began
